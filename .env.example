# ---- Backend (prefijo KLAW_) ----
# Proveedor LLM: anthropic | openai | none (none o sin key = modo demo)
KLAW_LLM_PROVIDER=anthropic
KLAW_ANTHROPIC_API_KEY=
KLAW_ANTHROPIC_MODEL=claude-sonnet-4-5
KLAW_OPENAI_API_KEY=
KLAW_OPENAI_MODEL=gpt-4o-mini

# Enriquecimiento de decisores (Hunter.io). Sin key = contactos demo.
KLAW_HUNTER_API_KEY=
KLAW_MAX_CONTACTS_PER_COMPANY=5

KLAW_CORS_ORIGINS=http://localhost:3000
KLAW_LOG_LEVEL=INFO

# ---- Frontend (se incrusta en build) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
